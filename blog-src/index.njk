---
layout: layouts/base.njk
permalink: /blog/index.html
eleventyComputed:
  title: "{{ site.blog.title }}"
  metaTitle: "{{ site.blog.metaTitle }}"
  description: "{{ site.blog.description }}"
  jsonld:
    "@context": "https://schema.org"
    "@type": "Blog"
    name: "Blog de Fabio Nogales"
    url: "{{ '/blog/' | absUrl }}"
    inLanguage: "es"
    description: "{{ site.blog.description }}"
    author:
      "@type": "Person"
      name: "{{ site.author.name }}"
      url: "{{ site.author.url }}"
    publisher:
      "@type": "Organization"
      name: "{{ site.publisher.name }}"
      logo:
        "@type": "ImageObject"
        url: "{{ site.publisher.logo }}"
---
{% set heading = site.blog.title %}{% set intro = site.blog.intro %}{% set posts = collections.posts %}{% set activeCat = "" %}
{% include "listing.njk" %}
